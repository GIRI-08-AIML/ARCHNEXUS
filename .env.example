# Copy this file to .env and edit it. Never commit .env: it holds secrets.

# ---------------------------------------------------------------- database
DATABASE_URL=postgresql+psycopg://archnexus:archnexus@localhost:5432/archnexus

# ---------------------------------------------------------------- security
# Signs login tokens. Set a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
TOKEN_EXPIRE_MINUTES=10080
# Failed sign-ins: lock out after this many wrong passwords for one account (from one address)
LOGIN_MAX_FAILURES=5
# ...or this many across all accounts from one address
LOGIN_IP_MAX_FAILURES=20
# How long the lockout lasts, in seconds
LOGIN_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------- model: pick ONE provider
# Option A: a local model with Ollama (free, private, slow on a laptop)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192

# Option B: a hosted model through an OpenAI-compatible API, for example Groq.
# Set LLM_PROVIDER=groq (or openai) and fill in the key. Model names change: check the provider's list.
# LLM_PROVIDER=groq
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1
# Free plans allow few calls per minute. If the log says "rate limit hit", lower this to 1 or 2.
# MAX_SPECIALIST_CONCURRENCY=2
# How often to wait and retry when the provider says "429 Too Many Requests", and the longest single wait.
# LLM_RATE_LIMIT_RETRIES=6
# LLM_RATE_LIMIT_MAX_WAIT=60

# ---------------------------------------------------------------- review behaviour
DEBATE_ROUNDS=1
# Only this many characters of the RFC are sent to the model (about 4 pages at 12000)
MAX_RFC_CHARS_IN_PROMPT=12000
# Check each finding against the RFC: drop what it already answers, lower inflated severities.
# Costs one extra model call per finding.
VERIFY_FINDINGS=true
